# Notion integration token. Create one at https://www.notion.so/my-integrations
# then share your TV page with the integration.
NOTION_API_KEY=[YOUR_NOTION_API_KEY]

# The Notion page the databases get created under.
# Grab it from the page URL: notion.so/Some-Page-<THIS_PART>
NOTION_PARENT_PAGE_ID=[YOUR_NOTION_PARENT_PAGE_ID]

# TMDB v3 API key, free: https://www.themoviedb.org/settings/api
TMDB_API_KEY=[YOUR_TMDB_API_KEY]

# Optional. Only needed if you want the weekly digest posted to Discord
# (make post / 09_weekly_discover.py --post). In Discord: channel settings >
# Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=[YOUR_DISCORD_WEBHOOK_URL]
